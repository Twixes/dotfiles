theme = GitHub Dark
font-family = "SF Mono"
font-size = 14
window-padding-x = 8
background-opacity = 0.8
background-blur = macos-glass-regular
window-width = 120
window-height = 40
font-thicken = true
cursor-style = bar
# Close a tab or window without asking, even with something like `devbox` still running:
# a detached tmux session on the sandbox comes back with the next `devbox`.
confirm-close-surface = false
